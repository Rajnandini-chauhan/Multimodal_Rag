# App
APP_NAME=PaperQA
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://paperqa:paperqa@localhost:5432/paperqa

# Auth
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXIRE_MINUTES=60

# Paper storage
UPLOAD_DIR=./storage/papers
MAX_UPLOAD_SIZE_MB=25

# NVIDIA NIM -- single provider for text + vision + embeddings.
# Get a free key at https://build.nvidia.com (valid 6 months).
# NEVER commit the real key. Only this .env.example belongs in git.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models (all hosted free on NVIDIA NIM)
LLM_MODEL=meta/llama-3.1-70b-instruct
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Vector store
CHROMA_PERSIST_DIR=./storage/chroma

# Async task queue
REDIS_URL=redis://localhost:6379/0

# Frontend (consumed via Vite)
VITE_API_URL=http://localhost:8000
